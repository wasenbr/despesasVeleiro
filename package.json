{
  "name": "despesas-veleiro",
  "version": "1.0.0",
  "private": true,
  "description": "Controle de despesas compartilhadas de um veleiro (PWA em TypeScript, Cloudflare Workers + D1 ou Node + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts && tsx src/server/node.ts",
    "start": "tsx src/server/node.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "import": "tsx scripts/import-ods.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "db:apply:local": "tsx scripts/apply-sql.ts",
    "db:migrate:local": "wrangler d1 migrations apply veleiro --local",
    "db:migrate:remote": "wrangler d1 migrations apply veleiro --remote"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
